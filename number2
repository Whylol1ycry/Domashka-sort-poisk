numbers = [2, 5, 8, 11, 14, 18, 21, 25, 30]#исходный список
chislo = 18#искомое число

left = 0#обозначаем границы для бинарного поиска: левая граница - 0
right = len(numbers) - 1#правая граница - длина списка минус 1 потому что список начинается с 0

index = -1#создаём переменную которая будет считать индекс искомого числа цикле и задаём значение -1, потому что индексация начинается с 0 

#цикл бинарного поиска (повторяем пока левая граница меньше либо равно правой, сужая таким образом границы поиска)
while left <= right:
    mid = (left + right) // 2#находим индекс среднего элемента

    if numbers[mid] == chislo:#если наше число посередине
        index = mid#то пишем индекс среднего
        break#останавливаем цикл
    elif numbers[mid] < chislo:#если среднее число меньше искомого
        left = mid + 1#ищем в правой половине тем, что отбросили левую половину и прибавляем к новой левой грани единицы пока не наткнёмся на наше число
    else:
        right = mid - 1 #если же среднее число больше искомого, то ищем в левой половине тем, что отбрасываем правую и прибавляем к правой грани единицу пока не наткнёмся на наше число

print(index)#когда нашли искомое число выводим его индекс
