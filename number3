spisok = [29, 10, 14, 37, 13]#исходный список

for i in range(len(spisok) - 1):#пишем цикл для всей длины цикла - 1, т.к. индексация начинается с 0
    min_idx = i#предполагаем, что i — минимальный
    
    for j in range(i + 1, len(spisok)):#вутренний цикл, ищем настоящий минимум в оставшейся части списка
        if spisok[j] < spisok[min_idx]:#если какой-то элемент с индексом j меньше нашего минимального элемента
            min_idx = j#то говорим, что минимальный элемент теперь с индексом j
            
    spisok[i], spisok[min_idx] = spisok[min_idx], spisok[i]#меняем местами найденный минимальный элемент с текущим
    
    print(f"Проход {i + 1}: {spisok}")#выводим состояние списка после каждого прохода

