def merge_sort(arr):#задаём команду для сортировки слиянием

    if len(arr) <= 1: 
        return arr #если 1 элемент или пусто — сортировать нечего, возвращаем его

    mid = len(arr) // 2#разделяем список пополам и рекурсивно сортируем части, так середина у нас будет тем что мы делим длину на 2
    left = merge_sort(arr[:mid])#отделяем левую половину списка и сортируем её
    right = merge_sort(arr[mid:])#отделяем правую половину спика и сортируем её

    # 2. Слияние: собираем элементы обратно в правильном порядке
    result = []#задаём новый пустой список
    while left and right:#пока в левом списке и в правом списке есть хотя бы по одному элементу, продолжай цикл
        if left[0] < right[0]:#мы сравниваем самые первые и самые маленькие элементы в обеих стопках.
            result.append(left.pop(0))#если из левого списка элемент меньше то добавляем его в список первее
        else:
            result.append(right.pop(0))#если же из правого списка элемент меньше, то добавляем его первее

    return result + left + right#добавляем остатки, если один из списков закончился раньше
list = [12, 4, 9, 1, 6, 3]#прописываем наш список из условия
sortlist = merge_sort(list)#пропписываем merge_sort для нашего списка, чтобы вообще всё остальное работало

print("Исходный список:", list)#прописываем исходный список
print("Отсортированный список:", sortlist)#прописываем отсортированный список
